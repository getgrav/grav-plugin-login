{% extends "forms/field.html.twig" %}

{# The profile page's 2-Factor Authentication panel, the same steps as Admin
   Next: off ("Enable 2FA"), finishing (QR code, secret, "Verify & Enable")
   and on ("Regenerate", "Disable"). Each step is its own task
   (login.regenerate2FASecret, login.twofaEnable, login.twofaDisable), so the
   panel posts nothing with the profile form, and 2FA goes on only once a
   code from the app checks out. Shown only on the signed-in member's own
   account. #}

{% block field %}
    {% set viewer = grav.user %}
    {% set user = form.object ?? viewer %}
    {% if viewer.username and user.username == viewer.username %}
        {% set active = grav.login.hasActiveTwoFactor(user) %}
        {% set secret = active ? null : grav.login.storedTwoFactorSecret(user) %}
        {% set stage = active ? 'on' : (secret ? 'finish' : 'off') %}
        {% set task = base_url_relative ~ '/task' ~ config.system.param_sep ~ 'login.' %}

        <div class="form-field twofa-panel {{ field.outerclasses }}" data-2fa-panel data-stage="{{ stage }}"
             data-url-generate="{{ (task ~ 'regenerate2FASecret')|e('html_attr') }}"
             data-url-enable="{{ (task ~ 'twofaEnable')|e('html_attr') }}"
             data-url-disable="{{ (task ~ 'twofaDisable')|e('html_attr') }}"
             data-strings="{{ { enterCode: 'PLUGIN_LOGIN.2FA_ENTER_CODE'|t, failed: 'PLUGIN_LOGIN.2FA_REQUEST_FAILED'|t }|json_encode|e('html_attr') }}">
            {{ nonce_field('login-form', 'login-form-nonce')|raw }}

            {# Off #}
            <div class="twofa-step" data-2fa-step="off" {{ stage != 'off' ? 'hidden' }}>
                <div class="twofa-head">
                    <svg class="twofa-icon twofa-icon-off" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/><path d="m14.5 9.5-5 5"/><path d="m9.5 9.5 5 5"/></svg>
                    <div class="twofa-head-text">
                        <p class="twofa-title">{{ 'PLUGIN_LOGIN.2FA_OFF_TITLE'|t }}</p>
                        <p class="twofa-text">{{ 'PLUGIN_LOGIN.2FA_OFF_TEXT'|t }}</p>
                    </div>
                    <button type="button" class="button button-small primary" data-2fa-generate>{{ 'PLUGIN_LOGIN.2FA_ENABLE'|t }}</button>
                </div>
            </div>

            {# Finishing: the app scans the QR code, then a code from it turns 2FA on #}
            <div class="twofa-step" data-2fa-step="finish" {{ stage != 'finish' ? 'hidden' }}>
                <div class="twofa-head">
                    <svg class="twofa-icon twofa-icon-finish" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/><path d="M12 8v4"/><path d="M12 16h.01"/></svg>
                    <div class="twofa-head-text">
                        <p class="twofa-title">{{ 'PLUGIN_LOGIN.2FA_FINISH_TITLE'|t }}</p>
                        <p class="twofa-text">{{ 'PLUGIN_LOGIN.2FA_FINISH_TEXT'|t }}</p>
                    </div>
                </div>
                <div class="twofa-qr">
                    <img class="twofa-qr-image" data-2fa-image alt="{{ 'PLUGIN_LOGIN.2FA_QR_ALT'|t }}" src="{{ secret ? grav.login.twoFactorAuth.getQrImageData(user.username, secret) : '' }}" />
                    <div class="twofa-secret-box">
                        <span class="twofa-label">{{ 'PLUGIN_LOGIN.2FA_SECRET_MANUAL'|t }}</span>
                        <code class="twofa-secret-code" data-2fa-secret>{{ secret ? secret|regex_replace('/(\\w{4})(?=\\w)/', '\\1 ') }}</code>
                    </div>
                </div>
                <label class="twofa-label" for="twofa-enable-code">{{ 'PLUGIN_LOGIN.2FA_VERIFICATION_CODE'|t }}</label>
                <div class="twofa-row">
                    <div class="form-input-wrapper twofa-code-wrapper">
                        <input type="text" id="twofa-enable-code" class="twofa-code" data-2fa-input="enable"
                               inputmode="numeric" autocomplete="one-time-code" maxlength="8" placeholder="{{ 'PLUGIN_LOGIN.2FA_CODE_INPUT'|t }}" />
                    </div>
                    <button type="button" class="button button-small primary" data-2fa-action="enable">{{ 'PLUGIN_LOGIN.2FA_VERIFY_ENABLE'|t }}</button>
                </div>
            </div>

            {# On #}
            <div class="twofa-step" data-2fa-step="on" {{ stage != 'on' ? 'hidden' }}>
                <div class="twofa-head">
                    <svg class="twofa-icon twofa-icon-on" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/><path d="m9 12 2 2 4-4"/></svg>
                    <div class="twofa-head-text">
                        <p class="twofa-title">{{ 'PLUGIN_LOGIN.2FA_ON_TITLE'|t }}</p>
                        <p class="twofa-text">{{ 'PLUGIN_LOGIN.2FA_ON_TEXT'|t }}</p>
                    </div>
                    <span class="twofa-head-actions" data-2fa-on-actions>
                        <button type="button" class="button button-small secondary" data-2fa-ask="regenerate">{{ 'PLUGIN_LOGIN.2FA_REGENERATE'|t }}</button>
                        <button type="button" class="button button-small secondary" data-2fa-ask="disable">{{ 'PLUGIN_LOGIN.2FA_DISABLE'|t }}</button>
                    </span>
                </div>

                {% for action in ['regenerate', 'disable'] %}
                    <div class="twofa-confirm" data-2fa-confirm="{{ action }}" hidden>
                        <label class="twofa-label" for="twofa-{{ action }}-code">{{ (action == 'disable' ? 'PLUGIN_LOGIN.2FA_DISABLE_PROMPT' : 'PLUGIN_LOGIN.2FA_REGENERATE_PROMPT')|t }}</label>
                        <div class="twofa-row">
                            <div class="form-input-wrapper twofa-code-wrapper">
                                <input type="text" id="twofa-{{ action }}-code" class="twofa-code" data-2fa-input="{{ action }}"
                                       inputmode="numeric" autocomplete="one-time-code" maxlength="8" placeholder="{{ 'PLUGIN_LOGIN.2FA_CODE_INPUT'|t }}" />
                            </div>
                            <button type="button" class="button button-small {{ action == 'disable' ? 'danger' : 'primary' }}" data-2fa-action="{{ action }}">{{ (action == 'disable' ? 'PLUGIN_LOGIN.2FA_CONFIRM_DISABLE' : 'PLUGIN_LOGIN.2FA_REGENERATE')|t }}</button>
                            <button type="button" class="button button-small secondary" data-2fa-cancel>{{ 'PLUGIN_LOGIN.2FA_CANCEL'|t }}</button>
                        </div>
                    </div>
                {% endfor %}
            </div>

            <p class="form-errors twofa-error" data-2fa-error role="alert" hidden></p>
            <p class="twofa-notice" data-2fa-notice role="status" hidden></p>
        </div>

        {% do assets.addJs('plugin://login/js/2fa.js', { 'group': 'bottom', 'loading': 'defer' }) %}
    {% endif %}
{% endblock %}
