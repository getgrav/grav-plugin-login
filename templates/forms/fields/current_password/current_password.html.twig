{% extends "forms/fields/password/password.html.twig" %}

{# The current password on the profile form. Left out for an account that has
   no password yet (one created by a sign-in service), which can set its first
   password without one. #}

{% block field %}
    {% set account = form.object ?? grav.user %}
    {% if grav.login.hasPassword(account) %}
        {{ parent() }}
    {% endif %}
{% endblock %}
